FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

COPY app.py /app/app.py
COPY report_column_normalizer.py /app/report_column_normalizer.py
COPY config/column_mappings.example.json /app/column_mappings.json
COPY config/report_names.example.json /app/report_names.json
COPY config/reports.example.txt /app/reports.txt

ENV PORT=8080
CMD ["python", "app.py"]

# Application
APP_ENV=local
PORT=8080
LOG_LEVEL=INFO

# Report provider authentication. Use Secret Manager in production.
PROVIDER_CLIENT_ID=replace-with-secret
PROVIDER_CLIENT_SECRET=replace-with-secret
PROVIDER_TOKEN_URL=https://api.example-provider.com/oauth2/accesstoken

# Storage
GCS_BUCKET=your-demo-bucket
GCS_PREFIX=report-ingestion
SAVE_DIR=/tmp

# Webhook/admin protection
WEBHOOK_API_KEY_NAME=x-webhook-key
WEBHOOK_API_KEY_VALUE=replace-with-secret
MANAGE_API_KEY=replace-with-secret
APP_SESSION_SECRET=replace-with-secret

# Config files
REPORTS_CONFIG_FILE=config/reports.example.txt
COLUMN_MAPPING_FILE=config/column_mappings.example.json
REPORT_NAMES_FILE=config/report_names.example.json

# SQL loader
INSTANCE_CONNECTION_NAME=your-project:your-region:your-sql-instance
DB_NAME=reports_db
DB_USER=report_loader
DB_PASS=replace-with-secret
POWERBI_USER=powerbi_reader
